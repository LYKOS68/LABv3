package views

templ crownIcon(class string) {
	<svg class={ class } viewBox="0 0 100 72" aria-hidden="true">
		<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
			<path stroke-width="4" d="M16 27 L25 56 L75 56 L84 27 L68 42 L51 24 L34 42 Z"></path>
			<path stroke-width="4" d="M22 63 Q50 69 78 63"></path>
		</g>
	</svg>
}

templ arrowIcon() {
	<svg class="arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
}

templ Home() {
	<!DOCTYPE html>
	<html lang="de">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="theme-color" content="#080907"/>
			<meta name="description" content="RAP-LAB — ein Ort für das, was zwischen Idee und Musik passiert."/>
			<title>RAP-LAB — Musik entwickeln. Menschen finden.</title>
			<link rel="preload" href="/static/fonts/permanent-marker-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="preload" href="/static/fonts/montserrat-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="preload" href="/static/fonts/karla-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="stylesheet" href="/static/app.css"/>
		</head>
		<body class="min-h-screen bg-ink text-paper antialiased">
			<header class="site-header">
				<div class="header-inner">
					<a class="brand" href="/" aria-label="RAP-LAB Startseite">
						@crownIcon("brand-crown")
						<span>RAP-LAB</span>
					</a>
					<nav class="main-nav" aria-label="Hauptnavigation">
						<a href="/" aria-current="page">Home</a>
						<a href="#">LAB-Studio</a>
						<a href="#">LAB-Connect</a>
						<a href="#">Über uns</a>
					</nav>
					<div class="header-actions">
						<a class="icon-btn" href="#" aria-label="Suche">
							<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path d="M16 16l4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
						</a>
						<a class="btn btn-outline btn-sm" href="#">Login</a>
						<a class="btn btn-gold btn-sm" href="#">Registrieren</a>
					</div>
				</div>
			</header>
			<main class="page">
				<section class="hero" aria-labelledby="hero-title">
					<div class="hero-main">
						<div class="wordmark">
							@crownIcon("wordmark-crown")
							<p class="wordmark-text">RAP-<span>LAB</span></p>
						</div>
						<h1 id="hero-title" class="hero-tagline">Ein Ort für das, <br/>was zwischen Idee <br/>und Musik passiert.</h1>
						<div class="hero-ctas">
							<a class="btn btn-gold" href="#">LAB-Studio starten @arrowIcon()</a>
							<a class="btn btn-outline" href="#">LAB-Connect entdecken @arrowIcon()</a>
						</div>
					</div>
					<aside class="honesty" aria-labelledby="honesty-title">
						<h2 id="honesty-title" class="honesty-title">Denn <span>mal ehrlich:</span></h2>
						<ul class="honesty-list">
							<li>Du kannst den nächsten Song auch wieder in deine Handy-Notizen schreiben.</li>
							<li>Den Producer kannst du wieder über fünf Ecken suchen.</li>
							<li>Den Mixer wieder in irgendeiner Instagram-Story finden.</li>
							<li>Den Videografen wieder irgendwo in einem Discord-Server suchen.</li>
							<li>Und deine Brancheninformationen kannst du dir wieder aus zehn verschiedenen Quellen zusammensuchen.</li>
							<li class="honesty-last">Oder du hörst irgendwann auf, deinen Musikprozess aus Einzelteilen zusammenzubauen.</li>
						</ul>
						<div class="signature">
							@crownIcon("signature-crown")
							<p><strong>RAP-LAB.</strong><span>Einfacher. Echter. Weiter.</span></p>
						</div>
					</aside>
				</section>
				<section class="cards" aria-label="Bereiche">
					<a class="card card-studio" href="#">
						<div class="card-body">
							<h2>LAB-Studio</h2>
							<p>Ideen festhalten. Projekte strukturieren. Dranbleiben.</p>
						</div>
						<span class="card-arrow">@arrowIcon()</span>
					</a>
					<a class="card card-connect" href="#">
						<div class="card-body">
							<h2>LAB-Connect</h2>
							<p>Producer, Mixer, Videografen und mehr finden. Direkt vernetzen.</p>
						</div>
						<span class="card-arrow">@arrowIcon()</span>
					</a>
					<div class="card card-steps" aria-label="Der Weg">
						<ol class="steps">
							<li>Song</li>
							<li>Mix</li>
							<li>Video</li>
							<li>Release</li>
							<li>Next Level …</li>
						</ol>
						@crownIcon("steps-crown")
					</div>
				</section>
			</main>
		</body>
	</html>
}
